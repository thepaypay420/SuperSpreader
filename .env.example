### Polymarket 5-Minute Chart Paper Trader
### Copy this file to .env and edit as needed.
### Focus: directional trading on 5m candles using EMA crossover + RSI + VWAP

### Modes
TRADE_MODE=paper
# paper: simulate fills + PnL
# shadow: place/cancel bookkeeping only (no fills)
EXECUTION_MODE=paper
# paper|scanner|backtest
RUN_MODE=paper

### Safety: set to 1 for live feeds only (no synthetic data)
DISALLOW_MOCK_DATA=0

### Connectivity (public endpoints; no private keys needed for paper)
# Polymarket market-channel WS used by the website:
POLYMARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Feed mode: mock|gamma|ws
POLYMARKET_FEED=mock
# Gamma market discovery:
GAMMA_BASE_URL=https://gamma-api.polymarket.com

### Market selection
MIN_24H_VOLUME_USD=10000
MIN_LIQUIDITY_USD=20000
TOP_N_MARKETS=50
MARKET_REFRESH_SECS=60

### Profitability frictions (Polymarket fees are 0; we model slippage+latency pessimistically)
FEES_BPS=0
SLIPPAGE_BPS=20
LATENCY_BPS=10

### Risk
MAX_FEED_LAG_SECS=300
MAX_SPREAD=0.20
MAX_POS_PER_MARKET=200
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT=200
MAX_EVENT_EXPOSURE=500
STOP_BEFORE_END_SECS=3600

### Position aging / unwind
MAX_POS_AGE_SECS=7200
UNWIND_INTERVAL_SECS=10
UNWIND_MAX_MARKETS_PER_CYCLE=2

### Base order sizing
BASE_ORDER_SIZE=10.0
PRICE_TICK=0.001

### ── 5-Minute Chart Strategy (PRIMARY) ──
ENABLE_FIVE_MIN_CHART=1

# Candle settings
CANDLE_INTERVAL_SECS=300
CANDLE_MAX_HISTORY=200

# EMA crossover periods
FIVE_MIN_FAST_EMA=9
FIVE_MIN_SLOW_EMA=21
FIVE_MIN_TREND_EMA=50

# RSI settings
FIVE_MIN_RSI_PERIOD=14
FIVE_MIN_RSI_OVERSOLD=30
FIVE_MIN_RSI_OVERBOUGHT=70

# ATR-based risk management
FIVE_MIN_ATR_PERIOD=14
FIVE_MIN_ATR_STOP_MULT=1.5
FIVE_MIN_ATR_TP_MULT=2.0
FIVE_MIN_ATR_TRAIL_TRIGGER=1.0
FIVE_MIN_ATR_TRAIL_DIST=1.0

# Position management
FIVE_MIN_MAX_HOLD_CANDLES=24
FIVE_MIN_MIN_CANDLES=55
FIVE_MIN_COOLDOWN_SECS=300

# Confluence filters (set to 0 to relax for testing)
FIVE_MIN_REQUIRE_VWAP=1
FIVE_MIN_REQUIRE_TREND=1
FIVE_MIN_REQUIRE_RSI=1

### Legacy strategies (off by default — 5m chart is primary)
ENABLE_CROSS_VENUE=0

### Paper fill simulation
PAPER_FILL_MODEL=maker_touch
PAPER_MIN_REST_SECS=1.0

### Paper restart behavior
PAPER_REHYDRATE_PORTFOLIO=1
PAPER_RESET_ON_START=0

### Storage / logs
SQLITE_PATH=./data/polymarket_trader.sqlite
LOG_LEVEL=INFO

### Dashboard
DASHBOARD_ENABLED=1
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_OPEN_BROWSER=1
# Paper-only reset button
DASHBOARD_ENABLE_RESET=0
